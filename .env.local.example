# Copy this file to .env.local and fill in the values

# Supabase Postgres — transaction pooler (runtime, port 6543)
DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"

# Supabase Postgres — session pooler (migrations, port 5432)
DATABASE_URL_UNPOOLED="postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"

# NextAuth — generate with: openssl rand -base64 32
NEXTAUTH_SECRET="your-secret-here"
NEXTAUTH_URL="http://localhost:3000"

# JWT — shared HS256 secret for cross-platform SSO.
# MUST be identical across hifamily, hugo, hiplan and himage.
# Generate with: openssl rand -base64 32
JWT_SECRET="your-shared-jwt-secret-here"

# Platform URLs (for cross-platform navigation)
NEXT_PUBLIC_HUGO_URL="http://localhost:3001"
NEXT_PUBLIC_PLANS_URL="http://localhost:3002"
NEXT_PUBLIC_PHOTO_URL="http://localhost:3003"

# Resend — get your API key at resend.com
RESEND_API_KEY="re_xxxxxxxxxxxxxxxxxxxx"
