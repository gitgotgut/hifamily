# Copy this file to .env.local and fill in the values

# PostgreSQL — pooler URL (runtime)
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.neon.tech/neondb?sslmode=require"

# PostgreSQL — direct URL (migrations)
DATABASE_URL_UNPOOLED="postgresql://USER:PASSWORD@HOST.neon.tech/neondb?sslmode=require"

# NextAuth — generate with: openssl rand -base64 32
NEXTAUTH_SECRET="your-secret-here"
NEXTAUTH_URL="http://localhost:3000"

# JWT — RS256 keys for cross-platform authentication
# Generate with: node -e "const crypto = require('crypto'); const {publicKey, privateKey} = crypto.generateKeyPairSync('rsa', {modulusLength: 2048}); console.log(privateKey.export({type: 'pkcs8', format: 'pem'})); console.log(publicKey.export({type: 'spki', format: 'pem'}));"
JWT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
JWT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----"

# Platform URLs (for cross-platform navigation)
NEXT_PUBLIC_HUGO_URL="http://localhost:3001"
NEXT_PUBLIC_PLANS_URL="http://localhost:3002"
NEXT_PUBLIC_PHOTO_URL="http://localhost:3003"

# Resend — get your API key at resend.com
RESEND_API_KEY="re_xxxxxxxxxxxxxxxxxxxx"
